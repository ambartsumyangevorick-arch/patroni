[Unit]
Requires=docker.service
After=docker.service
[Service]
ExecStartPre=-/usr/bin/docker rm --force %N
ExecStart=/usr/bin/docker run \
  --name=%N \
  --rm=true \
  --network=host \
  --cap-add=NET_ADMIN \
  --stop-timeout=30 \
  --entrypoint=/usr/local/sbin/keepalived \
  --label=co.elastic.logs/enabled=true \
  --volume=/etc/keepalived:/etc/keepalived:ro \
  registry-proxy.<blur>/osixia/keepalived:2.0.20 --dont-fork --vrrp --no-syslog --log-console --log-detail --use-file=/etc/keepalived/keepalived.conf
ExecStop=-/usr/bin/docker stop %N
Restart=always
StartLimitInterval=0
RestartSec=10
KillMode=process
[Install]
WantedBy=multi-user.target
